# Python
__pycache__/
*.py[cod]
*.pyo

# Machine-specific
python_path.txt
data/apps.json

# Secrets — keys, tokens and certificates never belong in the repo
.env
.env.*
.dev.vars
*.pem
*.key
*.pfx
*.p12
*.keystore
*.jks
credentials*.json
secrets*.json

# Logs
debug.log
*.log

# Tor runtime files — large binaries, not needed for web deployment
core/tor_bundle/
core/tor_data/

# Claude internal
.claude/

# IDE
.vscode/
.idea/

# Nuitka diagnostics
nuitka-crash-report.xml

# Build outputs — never commit these
build/
dist/
dist_nuitka/
dist_nuitka_pm/
obf_dist/
publish/.wrangler/
.DS_Store
publish/

# Wrangler local cache
.wrangler/

# Special app icons: only their sealed copies (assets/app-icon-special*.enc) are committed;
# the plain pictures stay on the maintainer's computer
packaging/macos/private/
assets/app-icon-special*.png
# Written by the build from the ST_PACK_KEY secret (scripts/pack_assets.py)
core/_pack_key.py
assets/app.pack
